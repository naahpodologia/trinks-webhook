# Porta HTTP (na Hostinger a variável PORT é definida pela plataforma)
PORT=3000

# Caminho do endpoint. Use um trecho difícil de adivinhar, ex.: /webhook/trinks/8f3k2...
WEBHOOK_PATH=/webhook/trinks

# Token opcional exigido na URL (?token=...). Deixe vazio para não exigir.
WEBHOOK_TOKEN=

# Pasta onde os eventos são gravados (arquivos .jsonl por dia e por tipo)
DATA_DIR=./data

# Lista de TopicArn aceitos, separados por vírgula. Preencha quando o Trinks informar.
# Vazio = aceita qualquer tópico com assinatura válida.
ALLOWED_TOPIC_ARNS=

# Confirmar inscrição automaticamente ao receber SubscriptionConfirmation (true/false)
AUTO_CONFIRM_SUBSCRIPTION=true

# SOMENTE PARA TESTE LOCAL: aceita mensagens sem assinatura válida. Nunca use em produção.
ALLOW_UNSIGNED=false
